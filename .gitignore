# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datasets bajados con scripts/collect-matches.mjs
/data

# artefactos de compilacion del cliente Tauri
/desktop-client/src-tauri/target

# Sesion del cliente de escritorio: contiene el token del usuario.
desktop-client/sesion.json

# Configuracion del overlay: contiene la clave de Riot del streamer.
desktop-client/overlay/data/
desktop-client/overlay-datos/
desktop-client/dist/
desktop-client/node_modules/
