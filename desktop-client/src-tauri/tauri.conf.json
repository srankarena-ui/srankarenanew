{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S-Rank Arena",
  "version": "0.1.0",
  "identifier": "gg.srankarena.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "S-Rank Arena",
        "width": 420,
        "height": 580,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:3000; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
