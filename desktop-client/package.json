{
  "name": "srank-arena-desktop",
  "productName": "S-Rank Arena",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente de S-Rank Arena: torneo, avisos de castigo y overlay de streamer.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "servidor": "node server.mjs",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.srankarena.desktop",
    "productName": "S-Rank Arena",
    "files": [
      "main.js",
      "server.mjs",
      "src/**/*",
      "overlay/**/*",
      "!overlay/data/**",
      "!overlay-datos/**",
      "!sesion.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "overlay/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "S-Rank Arena"
    },
    "icon": "build/icon.png"
  }
}
